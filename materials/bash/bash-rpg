#!/usr/bin/env bash
# Bash RPG: samodzielna edukacyjna gra tekstowa. Odpowiedzi nie są wykonywane.
# Uruchom: bash bash-rpg
set -euo pipefail
if [[ ${1:-} == -h || ${1:-} == --help ]]; then
  printf '%s\n' 'Użycie: bash bash-rpg' 'Gra tekstowa: trzy zadania z podstaw Bash. Bez instalacji i dostępu do sieci.'
  exit 0
fi
if (( $# > 0 )); then printf 'Nieznana opcja. Użyj --help.\n' >&2; exit 2; fi
declare -a questions=(
  'Jakim poleceniem sprawdzisz bieżący katalog?'
  'Jakim poleceniem wyświetlisz zawartość katalogu?'
  'Jakim poleceniem wyświetlisz napis Witaj?'
)
declare -a solutions=('pwd' 'ls' 'echo Witaj')
hp=3
score=0
printf '%s\n' 'BASH RPG | Wyprawa przez Terminal' 'Wpisuj polecenia jako odpowiedzi. Gra ich nie uruchamia.'
for ((i=0; i<${#questions[@]}; i++)); do
  printf '\nPoziom %d/3 | Energia: %d\n%s\n' "$((i+1))" "$hp" "${questions[i]}"
  if ! IFS= read -r -p '> ' answer; then
    printf '\nPrzerwano: koniec wejścia.\n'
    exit 0
  fi
  # Porównywanie literalne, bez eval ani uruchamiania tekstu gracza.
  if [[ "${answer#"${answer%%[![:space:]]*}"}" == "${solutions[i]}" ]]; then
    printf 'Poprawnie! +10 punktów.\n'
    ((score+=10))
  else
    hp=$((hp-1))
    printf 'Odpowiedź wzorcowa: %s. Pozostała energia: %d\n' "${solutions[i]}" "$hp"
    if ((hp == 0)); then break; fi
  fi
done
printf '\nKoniec wyprawy. Wynik: %d/30\n' "$score"
